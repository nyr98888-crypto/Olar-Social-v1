# ─── API Keys (server-only — never use NEXT_PUBLIC_ for these) ───
# Text/chat (home + Maya): OpenRouter ONLY — required
OPENROUTER_API_KEY=your_key_here
# Vision (reference uploads) — optional soft-skip
GEMINI_API_KEY=your_key_here
# Images: FAL.ai Flux Schnell
FAL_KEY=your_key_here
# Legacy / unused for text (disabled). Leave empty.
GROQ_API_KEY=
TOGETHER_API_KEY=

# ─── Database & Auth (Supabase) — public client keys only ───
# These NEXT_PUBLIC_* values are baked at `next build`.
# On Vercel: set them in Project Settings → Environment Variables, then Redeploy.
# Guest mode works WITHOUT these (no Google). Leave empty to force guest-only.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# ─── Campaigns DB (Turso / libSQL) — required for /api/campaigns ───
# Paste real values from Turso Dashboard → your DB → Connect.
# Never commit real tokens.
TURSO_DATABASE_URL=libsql://your-db-name-yourusername.turso.io
TURSO_AUTH_TOKEN=your_generated_turso_token_here

# Optional
# GOOGLE_AI_API_KEY=your_key_here   # fallback if GEMINI_API_KEY is unset
# XAI_API_KEY=your_key_here         # optional Grok backup after OpenRouter
# GROK_API_KEY=your_key_here        # alias for XAI_API_KEY
# NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
# FORCE_AI_FALLBACK=1               # (dev) force soft niche template in text chain

# See docs/VERCEL.md for Hobby cold-start + timeout notes.
